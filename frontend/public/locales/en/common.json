  "Rules": {
    "title": "Game Rules",
    "intro": "Welcome to CARTEADO! Here are the rules:",
    "rule1Title": "How the game starts",
    "rule1Text": "The game starts with you choosing from 6 cards. You select 3 cards that will be used at the end of the game and remain face down, and 3 cards that go directly into your hand.",

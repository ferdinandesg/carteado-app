// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // output = "../node_modules/@prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ProductType {
  DECK
  AVATAR
}

model User {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  image  String // Foto do provedor (Google). O avatar equipado vive no loadout.
  email  String
  Player Player[]
  rank   Int      @default(0)
  cash   Int?     @default(0)
  xp     Int?     @default(0)
  role   String?  @default("user")
  rooms  Room[]   @relation("owner")

  friendshipsSent     Friendship[] @relation("friendshipRequester")
  friendshipsReceived Friendship[] @relation("friendshipAddressee")

  inventory UserInventory[]
  loadout   UserLoadout?
}

// Catálogo: o que existe para comprar/equipar.
model Product {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  type        ProductType
  // Chave usada pelo front para resolver o asset (ex.: "baralho02").
  assetKey    String      @unique
  name        String
  description String
  price       Int
  imageUrl    String?
  // Todo usuário possui sem comprar (ex.: baralho01). Slot vazio resolve para ele.
  isDefault   Boolean     @default(false)
  // Sai da vitrine sem tirar de quem já comprou.
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)

  inventories UserInventory[]
}

// Posse: o que o usuário comprou.
model UserInventory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id])
  productId   String   @db.ObjectId
  purchasedAt DateTime @default(now())

  @@unique([userId, productId])
}

// Loadout: o que está equipado, um item por tipo (invariante no service).
model UserLoadout {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  user      User           @relation(fields: [userId], references: [id])
  userId    String         @unique @db.ObjectId
  slots     EquippedSlot[]
  updatedAt DateTime       @updatedAt
}

type EquippedSlot {
  type      ProductType
  productId String      @db.ObjectId
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  requester   User             @relation("friendshipRequester", fields: [requesterId], references: [id])
  requesterId String           @db.ObjectId
  addressee   User             @relation("friendshipAddressee", fields: [addresseeId], references: [id])
  addresseeId String           @db.ObjectId
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  // Uma única relação por par (a direção indica quem convidou)
  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Player {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  user        User?   @relation(fields: [userId], references: [id])
  userId      String? @db.ObjectId
  name        String
  hand        Card[] // Mão do jogador (privado)
  playedCards Card[] // Cartas que o jogador já baixou na sua área pessoal (visível para todos)
  image       String
  Room        Room?   @relation(fields: [roomId], references: [id])
  roomId      String? @db.ObjectId
  status      String?
  game        Game?   @relation(fields: [gameId], references: [id])
  gameId      String? @db.ObjectId
}

model Game {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  players Player[]
  status  String

  deck              CardData // Deck principal para comprar
  discardPile       Card[] // Monte de descarte (seu antigo "bunch")
  currentRoundCards Card[] // Cartas jogadas na rodada atual, no centro da mesa

  room       Room   @relation(fields: [roomId], references: [id])
  roomId     String @unique @db.ObjectId
  playerTurn String @db.ObjectId
}

model Room {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  hash      String
  name      String
  status    String?  @default("open")
  password  String?
  rule      String?
  size      Int
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    String   @db.ObjectId
  createdAt DateTime @default(now())
  owner     User?    @relation("owner", fields: [ownerId], references: [id])
  ownerId   String?  @db.ObjectId
  game      Game?
  gameId    String?  @db.ObjectId
  Player    Player[]
}

type CardData {
  cards              Card[]
  numbertOfFullDecks Int
}

model Chat {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  messages Message[]
  Room     Room[]
}

type Message {
  name      String
  message   String
  createdAt DateTime @default(now())
}

type Card {
  isHidden       Boolean?
  suit           String
  rank           String
  value          Int
  secondaryValue Int?
  toString       String?
}
